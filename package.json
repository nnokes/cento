{
  "name": "cento",
  "version": "0.0.0",
  "private": true,
  "description": "An EMI / Emily Howell-style recombinant composer for Max and Max for Live",
  "license": "MIT",
  "repository": "github:nnokes/cento",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "NODE_PATH=code/lib:code/max node --test tests/*.test.js",
    "build": "node tools/build.js",
    "build:watch": "node tools/build.js --watch",
    "build:check": "node tools/build.js --check",
    "check:paths": "node tools/check-paths.js",
    "patches": "python3 tools/maxgen.py",
    "patches:check": "python3 tools/maxgen.py --check",
    "hooks": "git config core.hooksPath tools/hooks"
  }
}
