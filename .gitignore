# macOS
.DS_Store

# Node (dev tooling only; there are no runtime dependencies)
node_modules/

# Python (tools/export-chorales.py)
__pycache__/
.venv/

# Frozen devices and built apps go to GitHub Releases, not the repo.
# Save frozen copies into frozen/ (outside patchers/, so Max never confuses
# them with the unfrozen devices).
frozen/
*.app/
build/
# The release zips (npm run package; docs/releasing.md).
dist/

# Working data lives in ~/Documents/cento, outside the repo. These catch
# corpus files or output copied in here by accident.
*.mid
*.midi
!tests/fixtures/**/*.mid
# Cento's own corpus (corpus/README.md): openly licensed, so it ships.
!corpus/**/*.mid

# Settings the patches remember between sessions (corpora, seed, output
# port...). Personal, and they hold absolute paths.
patchers/cento.settings.json

# Emily's taste (M9): your ratings, also personal.
patchers/cento.taste.json
patchers/cento.taste.backup.json
# Emily's own music (M10): what you accepted, and her snapshots.
patchers/cento.emily.json
patchers/cento.snapshots.json

# The same files under the project's old name (ml_midi, until after M11):
# copied to the names above the first time, then left as they were.
patchers/ml_midi.*.json

# Since M12 they live in your Cento folder, ~/Documents/Cento. If the
# repository itself is that folder, they're here: personal too.
/cento.*.json
